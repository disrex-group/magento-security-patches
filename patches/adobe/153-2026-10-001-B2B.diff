+declare(strict_types=1);
+
+namespace Magento\Company\Model\SaveValidator;
+
+use Magento\Company\Api\Data\CompanyInterface;
+use Magento\Company\Model\SaveValidatorInterface;
+use Magento\Framework\Filter\StripTags;
+
+/**
+ * Sanitizes the company region value.
+ */
+class SanitizeRegion implements SaveValidatorInterface
+{
+    /**
+     * @param CompanyInterface $company
+     * @param StripTags $stripTags
+     */
+    public function __construct(
+        private readonly CompanyInterface $company,
+        private readonly StripTags $stripTags
+    ) {
+    }
+
+    /**
+     * @inheritdoc
+     */
+    public function execute()
+    {
+        $region = $this->company->getRegion();
+        if (empty($region)) {
+            return;
+        }
+
+        $sanitized = trim($this->stripTags->filter($region));
+        $this->company->setRegion($sanitized);
+    }
+}
